# Docker Compose environment variables
# Copy this file to .env.docker and fill in the values, then run:
# docker compose --env-file .env.docker up

# PostgreSQL
POSTGRES_USER=yomeru
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=yomeru

# API
DATABASE_URL=postgresql://yomeru:change_me_in_production@postgres:5432/yomeru?schema=public
PORT=3001
NODE_ENV=production
# Set to your actual frontend URL in production (e.g., https://yomeru-app.vercel.app)
CORS_ORIGIN=http://localhost:3000

# Web
# IMPORTANT: Must be the real public API URL accessible by the browser.
# For production, set this to the actual API server URL (e.g., https://api.yourdomain.com).
NEXT_PUBLIC_API_URL=http://localhost:3001
